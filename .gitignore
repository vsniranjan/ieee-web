# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source rosters. Personal phone numbers, personal email addresses and
# IEEE membership IDs for every committee member — deliberately kept off the
# site, so they must not enter a public repo either. src/content/team.ts holds
# the parts that are meant to be published.
docs/
.vscode/
# Portrait originals as the members sent them: 48MB of full-resolution personal
# photographs, four of them carrying GPS coordinates in EXIF. Same rule as
# docs/. public/team/ holds the cropped, EXIF-stripped derivatives that ship,
# and scripts/portraits.ts regenerates them from a local copy of this folder.
images/execom_photos/
